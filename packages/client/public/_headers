# Cloudflare static assets: files that name other files must always be re-checked,
# so a new deploy is picked up on the next load. Hashed files in assets/ never change
# under the same name, so they can be cached for a year.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-store
/config.json
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
